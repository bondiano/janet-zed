----- SOURCE CODE
(def pi-ish 3.14159)

(defn circle [r]
  {:kind :circle :r r})

(defn area [shape]
  (case (shape :kind)
    :circle (* pi-ish (shape :r) (shape :r))
    :rect (* (shape :w) (shape :h))
    (errorf "unknown shape: %q" shape)))

(import ./shapes)

(defn total-area [items]
  (->> items
       (map shapes/area)
       (reduce + 0)))


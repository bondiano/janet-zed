---
source: server/tests/lsp.rs
expression: "format!(\"----- CURSOR\\n{}\\n\\n----- COMPLETIONS\\n{}\\n\",\nsession.cursor(\"(string/join lines\", 1), found.join(\"\\n\"))"
---
----- CURSOR
    (string/join lines "\n")))
     ↑

----- COMPLETIONS
Eid def
Entity def
TxReport def
db/pull (db/pull pattern: [:keyword] eid: Eid) -> Entity?
db/q (db/q query: :tuple & inputs) -> [[:any]]
db/transact (db/transact tx-data: [:any]) -> TxReport
items local: [(or {:kind :any & r} Shape)]
lines local: @[]
render (render items)
shapes/Circle def
shapes/Rect def
shapes/Shape def
shapes/area (shapes/area shape: Shape) -> :number
shapes/circle (shapes/circle r: :number) -> Circle
shapes/created var
shapes/pi-ish def
shapes/rect (shapes/rect w: :number h: :number) -> Rect
shapes/timed (shapes/timed & body)
summary (summary items)
total-area (total-area items)
